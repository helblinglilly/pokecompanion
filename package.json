{
  "name": "pokecompanion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:app",
    "build:assets": "node scripts/socialpreviews/socialGenerator.js",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "schema": "npx openapi-typescript https://api.pokecompanion.com/docs/swagger.json -o ./src/@types/api.d.ts",
    "schema:local": "npx openapi-typescript http://localhost:3000/docs/swagger.json -o ./src/@types/api.d.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@eslint/js": "^10.0.1",
    "@posthog/types": "^1.402.2",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/uuid": "^10.0.0",
    "baseline-browser-mapping": "^2.11.13",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "esm": "^3.2.25",
    "globals": "^17.9.0",
    "jest-dom": "^4.0.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "node-fetch": "^3.3.2",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "save-svg-as-png": "^1.4.17",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "posthog-js": "^1.415.1"
  }
}
